<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="0dp"
            app:cardCornerRadius="5dp"
            android:padding="5dp"
            android:background="@color/cardback"
            app:cardUseCompatPadding="true">

            <RelativeLayout
                android:id="@+id/data_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="80dp"
                android:background="@color/menuback"
                android:padding="5dp">

                <com.module.utils.custom_views.TextViewRobotoRegularBold
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="5dp"
                    android:text="Date : 23-02-2023"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- <androidx.appcompat.widget.AppCompatImageView
                     android:id="@+id/ivCloseddfds"
                     android:layout_width="30dp"
                     android:layout_height="30dp"
                     android:layout_alignParentEnd="true"
                     android:src="@drawable/i3" />-->

                <com.module.utils.custom_views.TextViewRobotoRegularBold
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvDate"
                    android:layout_marginTop="1dp"
                    android:text="Lorem Ipsum is simply dummy text of "
                    android:textColor="#2a0d82"
                    android:paddingStart="5dp"
                    android:textSize="15sp"
                    android:maxLines="2"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <com.module.utils.custom_views.TextViewRobotoRegular
                    android:id="@+id/tvDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvTitle"
                    android:layout_marginTop="4dp"
                    android:paddingStart="5dp"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:maxLines="2"
                    tools:text="Lorem Ipsum is simply dummy text of  " />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/cvImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="10dp"
            android:layout_marginStart="0dp"
            app:cardElevation="3dp"
            android:layout_centerVertical="true"
            android:background="@color/noticecardback"
            app:cardUseCompatPadding="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_view"
                android:layout_width="75dp"
                android:layout_height="75dp"
                android:src="@drawable/doc_icon"
                android:layout_gravity="center"
                android:padding="10dp"
                android:visibility="visible"/>

            <TextView
                android:id="@+id/tv_document_link"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textAlignment="center"
                android:gravity="center"
                android:text="link"
                android:visibility="gone"/>

        </androidx.cardview.widget.CardView>

    </RelativeLayout>

</LinearLayout>