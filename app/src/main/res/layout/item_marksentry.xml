<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:weightSum="0">


    <RelativeLayout
        android:id="@+id/llImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="5dp"
        android:layout_weight="1"
        android:background="@drawable/newbackground_edit"
        android:orientation="horizontal"
        android:weightSum="2">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profile_image"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentStart="true"
            android:layout_gravity="center"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/dummy" />

        <!--<ImageView
            android:id="@+id/iv_calendar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/girl"
            android:scaleType="fitXY"
            android:visibility="gone" />-->

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:layout_toEndOf="@id/profile_image"
            android:layout_weight="1"
            android:fontFamily="@font/arialmt"
            android:maxLines="1"
            android:text="01. AISHIKA TRIPATHI"
            android:textColor="@color/menucolor"
            android:textSize="12sp" />


    </RelativeLayout>

    <LinearLayout
        android:id="@+id/llEditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="visible"
        android:orientation="vertical">

        <EditText
            android:id="@+id/editTextMarks"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/newbackground_edit"
            android:enabled="true"
            android:hint="           "
            android:inputType="numberDecimal"
            android:padding="5dp"
            android:textColor="@color/menucolor"
            android:textColorHint="@color/menucolor"
            android:visibility="visible"
            tools:ignore="Autofill" />

        <Spinner
            android:id="@+id/spinnerMarks"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="5dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:background="@drawable/newbackground_edit"
            android:padding="5dp"
            android:spinnerMode="dropdown"
            android:visibility="gone"
            tools:ignore="Autofill" />


        <TextView
            android:id="@+id/tvFullMarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            android:fontFamily="@font/arialmt"
            android:visibility="gone"
            android:maxLines="1"
            android:text="(50)"
            android:textColor="@color/menucolor"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llSpinner"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:weightSum="2"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:background="@drawable/newbackground_edit"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvGetMarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/arialmt"
            android:layout_margin="3dp"
            android:maxLines="1"
            android:text=""
            android:visibility="visible"
            android:textColor="@color/menucolor"
            android:textSize="15sp" />

        <Spinner
            android:id="@+id/spinner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/menucolor"
            android:layout_gravity="center"
            android:visibility="visible"
            android:layout_marginStart="1dp"
            />

    </LinearLayout>

    <RadioButton
        android:id="@+id/radio_button"
        android:layout_width="35dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="1dp"
        android:layout_weight="0"
        android:buttonTint="@color/radio"
        android:shadowColor="@color/radio"
        android:textColor="@color/radio"
        android:textColorHint="@color/radio" />


</LinearLayout>