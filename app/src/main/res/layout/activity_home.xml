                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/menuback"
                        app:cardCornerRadius="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:weightSum="2">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <RelativeLayout
                                    android:id="@+id/rlAttendance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <ImageView
                                        android:id="@+id/attendance"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/attendance" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/attendance"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="ATTEN\nDANCE"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />


                                </RelativeLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="80dp"
                                    android:layout_marginTop="30dp"
                                    android:background="@color/line" />

                                <RelativeLayout
                                    android:id="@+id/rlMarksEntry"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <ImageView
                                        android:id="@+id/marksentry"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/marksentry" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/marksentry"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="MARKS\nENTRY"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="80dp"
                                    android:layout_marginTop="30dp"
                                    android:background="@color/line" />

                                <RelativeLayout
                                    android:id="@+id/rlVideoClasses"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <ImageView
                                        android:id="@+id/video"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:padding="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/takephoto" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/video"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="Take\nPhoto"
                                        android:textAlignment="center"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>



                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="80dp"
                                    android:layout_marginTop="30dp"
                                    android:background="@color/line" />

                                <RelativeLayout
                                    android:id="@+id/rlExamRoutine"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    android:layout_weight="1">

                                    <ImageView
