                                    android:visibility="visible"
                                    android:layout_weight="1">

                                    <ImageView
                                        android:id="@+id/teacher"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="5dp"

                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/teacherremarks" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/teacher"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="TEACHER\nREMARKS"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:weightSum="4">

                                <RelativeLayout
                                    android:id="@+id/rlClassRoutine"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="visible"
                                    android:layout_weight="1">

                                    <View
                                        android:layout_width="60dp"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginBottom="30dp"
                                        android:background="@color/line" />

                                    <ImageView
                                        android:id="@+id/classrountine"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/classrountine" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/classrountine"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="Time\nTable"
                                        android:textAlignment="center"
                                        android:textColor="@color/menucolor"
                                        android:textSize="14sp" />


                                </RelativeLayout>

                                <RelativeLayout
                                    android:id="@+id/rlAttendanceHistory"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">
                                    <View
                                        android:layout_width="1dp"
                                        android:layout_height="80dp"
                                        android:layout_marginTop="20dp"
                                        android:background="@color/line" />

                                    <View
                                        android:layout_width="60dp"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginBottom="30dp"
                                        android:background="@color/line" />

                                    <ImageView
                                        android:id="@+id/attendancehistroy"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:padding="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/attenh" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/attendancehistroy"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="ATTEND.\nHISTORY"
                                        android:textAlignment="center"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />


                                </RelativeLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="80dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/line" />

                                <RelativeLayout
                                    android:id="@+id/rlNotice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">

                                    <View
                                        android:layout_width="60dp"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginBottom="30dp"
                                        android:background="@color/line" />

                                    <ImageView
                                        android:id="@+id/notice_iconn"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/notice" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/notice_iconn"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="NOTICE"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>

                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="80dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/line" />

                                <RelativeLayout
                                    android:id="@+id/rlCircular"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    android:layout_weight="1">
                                    <View
                                        android:layout_width="60dp"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginBottom="30dp"
                                        android:background="@color/line" />

                                    <ImageView
                                        android:id="@+id/circular"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:padding="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/takephoto" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/circular"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="TAKE PHOTO"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>





                                <RelativeLayout
                                    android:id="@+id/rlStudyMatireal"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1">
                                    <View
                                        android:layout_width="60dp"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginBottom="30dp"
                                        android:background="@color/line" />

                                    <ImageView
                                        android:id="@+id/studymatireal"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/studymatireal" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/studymatireal"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="STUDY\nMATERIALS"
                                        android:textAlignment="center"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>


                                <View
                                    android:layout_width="1dp"
                                    android:layout_height="80dp"
                                    android:layout_marginTop="20dp"
                                    android:background="@color/line"
                                    android:visibility="gone"/>
                                <RelativeLayout
                                    android:id="@+id/rlLiveClass"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:visibility="gone"
                                    android:layout_weight="1">
                                    <View
                                        android:layout_width="60dp"
                                        android:layout_height="1dp"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginBottom="30dp"
                                        android:background="@color/line" />

                                    <ImageView
                                        android:id="@+id/live"
                                        android:layout_width="60dp"
                                        android:layout_height="60dp"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginTop="10dp"
                                        android:padding="10dp"
                                        android:visibility="invisible"
                                        android:layout_marginBottom="5dp"
                                        android:contentDescription="@string/app_name"
                                        android:src="@drawable/liveclass" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@+id/live"
                                        android:layout_centerHorizontal="true"
                                        android:layout_marginBottom="10dp"
                                        android:visibility="invisible"
                                        android:fontFamily="@font/arialmt"
                                        android:textAlignment="center"
                                        android:text="HOME\nWORK"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>


                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/school"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="30dp"
                    android:background="@drawable/background_edit"
                    app:cardBackgroundColor="@color/circular"
                    app:cardCornerRadius="10dp">

                    <TextView
                        android:id="@+id/tvCircular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="50dp"
                        android:layout_marginEnd="30dp"
                        android:layout_marginStart="60dp"
                        android:layout_marginBottom="50dp"
                        android:fontFamily="@font/arialmt"
                        android:text="The School Circulars Will be Displayed here"
                        android:textColor="@color/menucolor"
                        android:textSize="15sp" />


                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="30dp"
                    android:visibility="gone"
                    android:weightSum="4">

<!--                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_view_noticee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="5dp"
                        app:cardCornerRadius="10dp">-->

                        <RelativeLayout
                            android:id="@+id/rvTakePhoto"
                            android:layout_width="0dp"
                            android:background="@drawable/background_edit"
                            android:layout_weight="1"
                            android:elevation="5dp"
                            android:layout_marginStart="5dp"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/practiceworksheet"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="5dp"
                                android:padding="10dp"
                                android:layout_marginBottom="1dp"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/takephoto" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/practiceworksheet"
                                android:layout_centerHorizontal="true"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/arialmt"
                                android:text="Take\nPhoto"
                                android:textAlignment="center"
                                android:textColor="@color/menucolor"
                                android:textSize="12sp" />

                        </RelativeLayout>
<!--
                    </androidx.cardview.widget.CardView>-->

<!--                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_view_wlp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="10dp">-->

                        <RelativeLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:elevation="5dp"
                            android:layout_marginStart="5dp"
                            android:background="@drawable/background_edit"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/weeklylessonplan"
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:layout_centerHorizontal="true"
                                android:layout_marginTop="5dp"
                                android:layout_marginBottom="1dp"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/weeklylessonplan" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/weeklylessonplan"
                                android:layout_centerHorizontal="true"
                                android:layout_marginBottom="10dp"
                                android:fontFamily="@font/arialmt"
                                android:text="Weekly\nLesson Plan"
                                android:textAlignment="center"
                                android:textColor="@color/menucolor"
                                android:textSize="12sp" />

                        </RelativeLayout>

<!--                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_view_clb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
