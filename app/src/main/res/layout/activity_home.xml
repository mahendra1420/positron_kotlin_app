                                        android:layout_marginBottom="10dp"
                                        android:fontFamily="@font/arialmt"
                                        android:text="EXAM\nROUTINE"
                                        android:textAlignment="center"
                                        android:textColor="@color/menucolor"
                                        android:textSize="12sp" />

                                </RelativeLayout>

                                <RelativeLayout
